# Copie para .env e preencha. NUNCA versione o .env.

# --- Broker MQTT (dados fornecidos pela disciplina) ---
MQTT_HOST=broker.exemplo.invalido
MQTT_PORT=1883
MQTT_USER=consumidor
MQTT_PASSWORD=
MQTT_TLS=false
# Ramo JSON do Meshtastic: msh/<raiz>/2/json/<canal>/!<id_gateway>
MQTT_TOPIC=msh/+/2/json/#
MQTT_CLIENT_ID=jonah-consumidor-pacotes-brutos

# --- MongoDB ---
MONGO_URI=mongodb://usuario:senha@host-mongo.exemplo.invalido:27017/?authSource=admin
MONGO_DB=meshtastic
MONGO_COLLECTION=pacotes_brutos

# --- Opcionais ---
# LOG_DIR=logs
# LOG_LEVEL=INFO
# HEARTBEAT_SEGUNDOS=60
# BUFFER_MAX=10000
